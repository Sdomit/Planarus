# Approvo — hosted deployment environment (example). Copy, fill in, and load via
# your platform's secret manager. Every one of these is OFF/absent by default, so
# omitting the file runs the local single-user tool. NEVER commit real secrets.

# --- Database (P10.0) ---------------------------------------------------------
# Managed Postgres. The app and Alembic both read this.
AGENTBOARD_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/approvo

# --- Identity + tenancy (P10.1 / P10.2 / P10.2b) ------------------------------
# Turn on hosted auth + workspace-scoped tenant enforcement.
AGENTBOARD_AUTH_ENABLED=true
# Server-side session lifetime (hours); default 720 (30 days).
# AGENTBOARD_AUTH_SESSION_TTL_HOURS=720
# Leave the dev-login provider OFF in a real deployment — it is an
# unauthenticated account-creation path. Real OAuth wiring is P10.1b.
# AGENTBOARD_AUTH_DEV_LOGIN=false

# --- Storage (P10.3) ----------------------------------------------------------
# "local" (default) or a hosted object store when the S3 adapter lands (P10.3b).
AGENTBOARD_STORAGE_BACKEND=local

# --- Web origins (P10.4) ------------------------------------------------------
# The hosted frontend origin(s), comma-separated. Added to CORS + Origin checks.
AGENTBOARD_WEB_ORIGINS=https://app.example.com

# --- External API (Phase 7C1) — stays disabled unless you deliberately expose it
# AGENTBOARD_EXTERNAL_API_ENABLED=false
# AGENTBOARD_EXTERNAL_API_ALLOWED_HOSTS=
