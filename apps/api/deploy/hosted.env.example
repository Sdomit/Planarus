# Planarus — hosted deployment environment (example). Copy, fill in, and load via
# your platform's secret manager. Every one of these is OFF/absent by default, so
# omitting the file runs the local single-user tool. NEVER commit real secrets.

# --- Database (P10.0) ---------------------------------------------------------
# Managed Postgres. The app and Alembic both read this.
PLANARUS_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/planarus

# --- Identity + tenancy (P10.1 / P10.2 / P10.2b) ------------------------------
# Turn on hosted auth + workspace-scoped tenant enforcement.
PLANARUS_AUTH_ENABLED=true
# Server-side session lifetime (hours); default 720 (30 days).
# PLANARUS_AUTH_SESSION_TTL_HOURS=720
# Leave the dev-login provider OFF in a real deployment — it is an
# unauthenticated account-creation path.
# PLANARUS_AUTH_DEV_LOGIN=false

# Real OAuth (P10.1b) — a provider is available only when its client id is set.
# Requires the [oauth] extra (httpx). Register an OAuth app with each provider and
# set the callback to https://<your-api>/api/v1/auth/oauth/<provider>/callback.
# PLANARUS_OAUTH_GOOGLE_CLIENT_ID=...
# PLANARUS_OAUTH_GOOGLE_CLIENT_SECRET=...
# PLANARUS_OAUTH_GITHUB_CLIENT_ID=...
# PLANARUS_OAUTH_GITHUB_CLIENT_SECRET=...

# --- Calendar external sync (P15.12b–d) ---------------------------------------
# Two-way sync to Google/Microsoft calendars. Fully inert unless the ENCRYPTION
# KEY and a provider client id are BOTH set. Requires the [calendar-sync] extra
# (httpx + cryptography). Distinct OAuth apps from the login OAuth above — these
# need offline calendar scopes. Register the callback as
# https://<your-app>/api/v1/calendar-sync/<provider>/callback
#   Google:    Calendar API + OAuth client (scope calendar.events, offline access)
#   Microsoft: Azure AD app, Graph delegated scope Calendars.ReadWrite + offline_access
# Generate the key with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PLANARUS_CALENDAR_ENC_KEY=...
# PLANARUS_CALENDAR_GOOGLE_CLIENT_ID=...
# PLANARUS_CALENDAR_GOOGLE_CLIENT_SECRET=...
# PLANARUS_CALENDAR_MICROSOFT_CLIENT_ID=...
# PLANARUS_CALENDAR_MICROSOFT_CLIENT_SECRET=...

# --- Storage (P10.3 / P10.3b) -------------------------------------------------
# "local" (default), "memory", or "s3". For s3, install the [s3] extra and set the
# bucket/region (credentials come from the standard AWS chain; set an endpoint URL
# for S3-compatibles like MinIO/R2).
PLANARUS_STORAGE_BACKEND=local
# PLANARUS_S3_BUCKET=planarus-artifacts
# PLANARUS_S3_PREFIX=
# PLANARUS_S3_REGION=us-east-1
# PLANARUS_S3_ENDPOINT_URL=

# --- Web origins (P10.4) ------------------------------------------------------
# The hosted frontend origin(s), comma-separated. Added to CORS + Origin checks.
PLANARUS_WEB_ORIGINS=https://app.example.com

# --- External API (Phase 7C1) — stays disabled unless you deliberately expose it
# PLANARUS_EXTERNAL_API_ENABLED=false
# PLANARUS_EXTERNAL_API_ALLOWED_HOSTS=
